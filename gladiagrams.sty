\tikzset{axpic/.style={baseline=(current bounding box.center), line cap=round}}

% "=" annotated with the justification for the step, used between diagrams
% in equational proof chains, e.g. \begin{tikzpicture}...\end{tikzpicture}
% \eqby{(P5)}\begin{tikzpicture}...\end{tikzpicture}
\newcommand{\eqby}[1]{\mathrel{\overset{\text{\scriptsize #1}}{=}}}

% Scale content down to fit the line width, otherwise leave it untouched.
\newcommand{\fits}[1]{\begingroup\setbox0=\hbox{$\displaystyle #1$}\ifdim\wd0>\linewidth\resizebox{\linewidth}{!}{\box0}\else\box0\fi\endgroup}
\newcommand{\diageq}[2]{%
  \begin{tikzpicture}[axpic]#1\end{tikzpicture}%
  \;\begin{tikzpicture}[axpic]\node{$=$};\end{tikzpicture}\;%
  \begin{tikzpicture}[axpic]#2\end{tikzpicture}%
}

\newcommand{\diagdef}[2]{%
  \begin{tikzpicture}[axpic]#1\end{tikzpicture}%
  \;\begin{tikzpicture}[axpic]\node{$\coloneq$};\end{tikzpicture}\;%
  \begin{tikzpicture}[axpic]#2\end{tikzpicture}%
}
% one row: label, LHS, RHS — auto = sign and spacing
\newcommand{\diagrow}[3]{%
    #1 & \begin{tikzpicture}[axpic]#2\end{tikzpicture}
     & \;\begin{tikzpicture}[axpic]\node{$=$};\end{tikzpicture}\;%
     & \begin{tikzpicture}[axpic]#3\end{tikzpicture} \\[1mm]
 }

\newcommand{\diagrowc}[3]{%
    #1 & \begin{tikzpicture}[axpic]#2\end{tikzpicture}
     & \;\begin{tikzpicture}[axpic]\node{$\supseteq$};\end{tikzpicture}\;%
     & \begin{tikzpicture}[axpic]#3\end{tikzpicture} \\[1mm]
 }
 \newcommand{\inlinegen}[1]{
    \begin{tikzpicture}
        \pic {#1};
    \end{tikzpicture}
}
